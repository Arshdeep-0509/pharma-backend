# Copy to .env and fill in your PostgreSQL password.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/pharma_inventory
CORS_ORIGINS=http://localhost:3000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=12
# true when served over HTTPS
COOKIE_SECURE=false
# lax: frontend and API on the same site. none: frontend on a different site (e.g. Vercel + Vercel)
COOKIE_SAMESITE=lax
